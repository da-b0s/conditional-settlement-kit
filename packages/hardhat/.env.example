# ---------------------------------------------------------------------------
# NONE OF THIS IS NEEDED TO RUN THE TEMPLATE.
#
# `yarn next:dev` serves every page without it. /feeds reads the live
# Chainlink feeds, /evidence reads any public topic, and both do it with a
# plain HTTP request and no credentials. The tests — 160 unit and 79 contract —
# all pass on a machine that has never seen a key.
#
# You need what is below only to WRITE to Hedera: deploy the contracts, or
# create a topic to publish evidence to.
# ---------------------------------------------------------------------------

# The operator SDK network. The contracts and app target testnet only.
HEDERA_NETWORK=testnet

# JSON-RPC endpoint. The default is Hashio's public testnet relay.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# ---------------------------------------------------------------------------
# Deployer — for `yarn hardhat:deploy`
#
# Generated by `yarn account:generate` or `yarn account:import`, and stored
# ENCRYPTED. The raw key is never written to disk; you are prompted for the
# password at deploy time.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# ---------------------------------------------------------------------------
# Operator — for `yarn evidence:topic` and for publishing evidence
#
# This one IS a raw key, because the Hiero SDK needs it to sign. Use a
# throwaway testnet account funded from the faucet, never an account that
# holds anything.
#
#   https://portal.hedera.com/faucet
#
# .gitignore blocks .env before any file that could hold a key. Deleting a
# committed key does not help: git keeps history, and bots scrape GitHub for
# Hedera keys within seconds.
# ---------------------------------------------------------------------------
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
