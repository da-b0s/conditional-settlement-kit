# ---------------------------------------------------------------------------
# All optional. The app runs with none of it.
# ---------------------------------------------------------------------------

# The topic /evidence opens on by default. Leave empty to use this project's
# own testnet topic (PROJECT_EVIDENCE_TOPIC in lib/settlement/hcs.ts). Set it
# to the topic `yarn evidence:topic` created for your own deployment. Any
# other topic id can still be typed into the page.
NEXT_PUBLIC_EVIDENCE_TOPIC=

# RPC override. The default is Hashio's public testnet relay.
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# WalletConnect. The scaffold ships a shared default that works for
# development; get your own from https://cloud.walletconnect.com before you
# put this in front of real users.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
