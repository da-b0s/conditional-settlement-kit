# ---------------------------------------------------------------------------
# All optional. The app runs with none of it.
# ---------------------------------------------------------------------------

# The topic /evidence opens on by default. Create one with
# `yarn evidence:topic`. Without it the page renders with an empty field and
# reads whatever topic id you type — which is the whole point: auditing a
# settlement needs no configuration and no permission.
NEXT_PUBLIC_EVIDENCE_TOPIC=

# RPC overrides. Defaults are Hashio's public relays.
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=

# WalletConnect. The scaffold ships a shared default that works for local
# development; get your own from https://cloud.walletconnect.com before you
# put this in front of real users.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
